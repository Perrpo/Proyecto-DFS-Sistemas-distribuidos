# ============================================================
# MiniDFS – Variables de Entorno
# Copiar este archivo a .env y ajustar los valores
# ============================================================

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET=minidfs-secret-key-change-in-production
JWT_EXPIRY_HOURS=24

# ── NameNode ──────────────────────────────────────────────
NAMENODE_HOST=localhost
NAMENODE_PORT=50051
NAMENODE_DB_PATH=./namenode.db

# ── Bloques ───────────────────────────────────────────────
BLOCK_SIZE=67108864          # 64 MB en bytes
REPLICATION_FACTOR=3

# ── Heartbeat ─────────────────────────────────────────────
HEARTBEAT_INTERVAL=10        # segundos entre heartbeats
HEARTBEAT_TIMEOUT=30         # segundos sin heartbeat → nodo inactivo
BLOCK_REPORT_INTERVAL=60     # segundos entre block reports

# ── DataNode (sobreescribir por cada instancia) ───────────
NODE_ID=dn1
DATANODE_HOST=localhost
DATANODE_PORT=50061
DATANODE_STORAGE_PATH=./blocks

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO               # DEBUG, INFO, WARNING, ERROR
